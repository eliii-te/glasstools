#!/usr/bin/env python3
"""
glassy-update — interactive TUI for the GlassyOS smart updater.

Animated splash, arrow-key menu, real update actions with rolling
backups, and a hidden admin/publish console gated by a secret command,
the user's login PIN, and an admin password.
"""

from __future__ import annotations

import argparse
import errno
import getpass
import hashlib
import json
import os
import re
import shutil
import signal
import subprocess
import sys
import tarfile
import termios
import time
import tty
import urllib.error
import urllib.request
from datetime import datetime
from pathlib import Path

# ───── Identity & secrets ────────────────────────────────────────────
VERSION = "ALPHA:0.1"
SALT = "glassyos-updater-v1"
SECRET_TRIGGER = "hk2ksje937Hks+23"
ADMIN_PIN_HASH = "146268eab30c78b8a944e248e734f1a99bc57d4855b31e5d32c7de5352a1cb4a"
ADMIN_PWD_HASH = "a179ba4100da496d6bad861bbf8cbc03ad81e33af0ce8edc27759726e12c358a"

# ───── Paths ─────────────────────────────────────────────────────────
HOME = Path.home()
USER_BACKUP_ROOT = HOME / ".local/share/glassy/backups"
USER_RELEASE_DIR = HOME / ".local/share/glassy/releases"
USER_CONFIG_DIR = HOME / ".config/glassy"
USER_CONFIG_FILE = USER_CONFIG_DIR / "updater.conf"
GLASSY_VERSION_FILE = Path("/etc/glassyos-release")
GLASSY_VERSION_USER = USER_CONFIG_DIR / "glassyos-release"


def _writable_or(root: Path, fallback: Path) -> Path:
    try:
        root.mkdir(parents=True, exist_ok=True)
        probe = root / ".probe"
        probe.touch()
        probe.unlink()
        return root
    except (PermissionError, OSError):
        fallback.mkdir(parents=True, exist_ok=True)
        return fallback


BACKUP_ROOT = _writable_or(Path("/var/lib/glassyos/backups"), USER_BACKUP_ROOT)
RELEASE_DIR = _writable_or(Path("/var/lib/glassyos/releases"), USER_RELEASE_DIR)

# ───── Theme (ANSI 24-bit) ───────────────────────────────────────────
class C:
    SKY  = "\033[38;2;184;208;255m"
    ICE  = "\033[38;2;232;239;255m"
    DIM  = "\033[38;2;108;122;150m"
    DEEP = "\033[38;2;78;90;120m"
    HOT  = "\033[38;2;255;176;114m"
    OK   = "\033[38;2;132;220;160m"
    WARN = "\033[38;2;255;200;120m"
    ERR  = "\033[38;2;255;120;120m"
    BG_DEEP = "\033[48;2;7;10;20m"
    BOLD = "\033[1m"
    DIM2 = "\033[2m"
    ITAL = "\033[3m"
    RST  = "\033[0m"
    HIDE = "\033[?25l"
    SHOW = "\033[?25h"
    CLR  = "\033[2J\033[H"
    EOL  = "\033[K"


def supports_tty() -> bool:
    return sys.stdout.isatty() and sys.stdin.isatty()


# ───── Logo (ASCII triangle peak — matches Plymouth/onboarding) ──────
LOGO = [
    "             ▲             ",
    "            ▲ ▲            ",
    "           ▲   ▲           ",
    "          ▲  ▲  ▲          ",
    "         ▲  ▲ ▲  ▲         ",
    "        ▲  ▲   ▲  ▲        ",
    "       ▲▲▲▲▲   ▲▲▲▲▲       ",
]


# ───── Terminal helpers ──────────────────────────────────────────────
def term_size() -> tuple[int, int]:
    try:
        sz = shutil.get_terminal_size((100, 30))
        return sz.columns, sz.lines
    except OSError:
        return 100, 30


def write(*parts: str) -> None:
    sys.stdout.write("".join(parts))
    sys.stdout.flush()


def move(row: int, col: int) -> str:
    return f"\033[{row};{col}H"


def center_pad(text: str, width: int) -> str:
    visible = re.sub(r"\033\[[0-9;]*m", "", text)
    pad = max(0, (width - len(visible)) // 2)
    return " " * pad + text


class RawMode:
    """Context manager: put stdin in cbreak mode (single-key reads, no echo).

    Cursor visibility is managed separately so menu loops don't flicker.
    """

    def __enter__(self):
        self.fd = sys.stdin.fileno()
        self.old = termios.tcgetattr(self.fd)
        tty.setcbreak(self.fd)
        return self

    def __exit__(self, *exc):
        termios.tcsetattr(self.fd, termios.TCSADRAIN, self.old)


def read_key() -> str:
    """Read a key. Returns 'UP'/'DOWN'/'LEFT'/'RIGHT'/'ENTER'/'ESC'/'TAB'/'BACK' or a single char.

    Uses os.read on the raw fd so Python's TextIOWrapper buffer doesn't swallow
    the trailing bytes of escape sequences (which would make arrow keys vanish).
    """
    import select
    fd = sys.stdin.fileno()
    b = os.read(fd, 1)
    if not b:
        return ""
    ch = b.decode("utf-8", errors="replace")
    if ch == "\x1b":
        # Drain the rest of the escape sequence if it's already in the FD.
        if select.select([fd], [], [], 0.08)[0]:
            rest = os.read(fd, 8).decode("utf-8", errors="replace")
            if rest.startswith("[A"): return "UP"
            if rest.startswith("[B"): return "DOWN"
            if rest.startswith("[C"): return "RIGHT"
            if rest.startswith("[D"): return "LEFT"
            return "ESC"
        return "ESC"
    if ch in ("\r", "\n"):
        return "ENTER"
    if ch == "\t":
        return "TAB"
    if ch in ("\x7f", "\b"):
        return "BACK"
    if ch == "\x03":
        raise KeyboardInterrupt()
    return ch


# ───── Splash animation ──────────────────────────────────────────────
def splash() -> None:
    if not supports_tty():
        return

    cols, rows = term_size()
    write(C.CLR, C.HIDE)

    # Vertical centering
    logo_h = len(LOGO)
    block_h = logo_h + 6
    top = max(2, (rows - block_h) // 2)

    # Animate logo line-by-line with shimmer color
    palette = [C.DEEP, C.SKY, C.ICE, C.SKY, C.DIM]
    for i, line in enumerate(LOGO):
        for shade in palette:
            write(move(top + i, 1), C.EOL, center_pad(f"{shade}{line}{C.RST}", cols))
            time.sleep(0.012)
        write(move(top + i, 1), C.EOL, center_pad(f"{C.SKY}{line}{C.RST}", cols))
        time.sleep(0.022)

    # Soft pause
    time.sleep(0.18)

    # Title typewriter
    title = "GlassyOS  smart  updater"
    title_y = top + logo_h + 2
    write(move(title_y, 1), C.EOL)
    pad = max(0, (cols - len(title)) // 2)
    write(" " * pad)
    for ch in title:
        write(f"{C.BOLD}{C.ICE}{ch}{C.RST}")
        time.sleep(0.018)

    # Version line
    ver = f"·  ver: {VERSION}  ·"
    write(move(title_y + 1, 1), C.EOL)
    pad2 = max(0, (cols - len(ver)) // 2)
    write(" " * pad2)
    for ch in ver:
        write(f"{C.HOT}{ch}{C.RST}")
        time.sleep(0.012)

    time.sleep(0.45)
    # Hint
    hint = "press any key to continue"
    write(move(title_y + 3, 1), C.EOL,
          center_pad(f"{C.DIM2}{C.DIM}{hint}{C.RST}", cols))
    sys.stdout.flush()

    with RawMode():
        read_key()
    write(C.CLR)


# ───── Frame & header rendering ──────────────────────────────────────
def render_chrome(title: str, subtitle: str = "") -> int:
    """Clear screen, render top chrome, return the row where content begins."""
    cols, _ = term_size()
    write(C.CLR)
    bar = "─" * max(0, cols - 4)
    write(move(1, 1), f"{C.DIM}╭{bar}╮{C.RST}")

    head = f" {C.BOLD}{C.ICE}GlassyOS{C.RST}  {C.DIM}smart updater{C.RST}  {C.HOT}·  {VERSION}{C.RST} "
    head_visible = re.sub(r"\033\[[0-9;]*m", "", head)
    write(move(2, 1),
          f"{C.DIM}│{C.RST}{head}{' ' * max(0, cols - 2 - len(head_visible))}{C.DIM}│{C.RST}")
    write(move(3, 1), f"{C.DIM}├{bar}┤{C.RST}")

    write(move(4, 3), f"{C.BOLD}{C.SKY}{title}{C.RST}")
    if subtitle:
        write(move(5, 3), f"{C.DIM}{subtitle}{C.RST}")
        return 7
    return 6


def footer(text: str) -> None:
    cols, rows = term_size()
    bar = "─" * max(0, cols - 4)
    write(move(rows - 2, 1), f"{C.DIM}╰{bar}╯{C.RST}")
    write(move(rows - 1, 3), f"{C.DIM}{text}{C.RST}{C.EOL}")


# ───── Main menu ─────────────────────────────────────────────────────
MENU_ITEMS = [
    ("update_glassyos", "Update GlassyOS",
     "Pull the next OS release: kernel, base packages, glassy-* scripts."),
    ("update_mirrors", "Update mirrors",
     "Re-rank and rewrite the pacman mirrorlist for fastest sources."),
    ("update_repos", "Update repos",
     "Refresh arch + blackarch package databases (-Syy)."),
    ("update_apps", "Update system applications",
     "Upgrade every installed package: pacman, AUR, flatpak, pipx, cargo, npm."),
    ("update_everything", "Update everything",
     "Full sweep: mirrors → repos → applications → glassyOS. Slowest, safest."),
    ("update_specific", "Update specific package",
     "Pick exactly one package or file to update via fuzzy search."),
    ("__sep__", "", ""),
    ("exit", "Exit", "Leave the updater."),
]


def main_menu() -> str:
    selected = 0
    cmd_buffer = ""
    cmd_mode = False
    cmd_input = ""

    write(C.HIDE)
    while True:
        if not cmd_mode:
            write(C.HIDE)
        cols, rows = term_size()
        content_start = render_chrome("Choose an action",
                                      "↑↓ navigate  ·  Enter select  ·  : command  ·  q quit")
        # Render menu items
        for i, (key, label, desc) in enumerate(MENU_ITEMS):
            row = content_start + i
            if key == "__sep__":
                write(move(row, 5), f"{C.DIM}{'─' * 40}{C.RST}")
                continue
            if i == selected:
                write(move(row, 3),
                      f"{C.HOT}▶{C.RST} {C.BOLD}{C.ICE}{label}{C.RST}")
                write(move(row, 40), f"{C.DIM}{desc}{C.RST}{C.EOL}")
            else:
                write(move(row, 3), f"  {C.DEEP}{label}{C.RST}{C.EOL}")

        # Footer / command line
        if cmd_mode:
            footer(f": {cmd_input}_")
        else:
            footer("↑↓ Enter  ·  : opens command  ·  q quit")

        sys.stdout.flush()

        with RawMode():
            try:
                key = read_key()
            except KeyboardInterrupt:
                return "exit"

        if cmd_mode:
            if key == "ENTER":
                write(C.HIDE)
                handle_command(cmd_input.strip())
                cmd_mode = False
                cmd_input = ""
            elif key == "ESC":
                write(C.HIDE)
                cmd_mode = False
                cmd_input = ""
            elif key == "BACK":
                cmd_input = cmd_input[:-1]
            elif len(key) == 1 and key.isprintable():
                cmd_input += key
            continue

        if key == "UP":
            selected = (selected - 1) % len(MENU_ITEMS)
            while MENU_ITEMS[selected][0] == "__sep__":
                selected = (selected - 1) % len(MENU_ITEMS)
        elif key == "DOWN":
            selected = (selected + 1) % len(MENU_ITEMS)
            while MENU_ITEMS[selected][0] == "__sep__":
                selected = (selected + 1) % len(MENU_ITEMS)
        elif key == "ENTER":
            choice = MENU_ITEMS[selected][0]
            if choice == "exit":
                return "exit"
            return choice
        elif key == "q":
            return "exit"
        elif key == "ESC":
            # Stale ESC from a half-decoded arrow key — ignore.
            continue
        elif key == ":":
            cmd_mode = True
            cmd_input = ""
            write(C.SHOW)
        elif len(key) == 1:
            # Hidden trigger buffer: collect printable chars; if buffer ends with the secret trigger, fire admin
            cmd_buffer = (cmd_buffer + key)[-len(SECRET_TRIGGER):]
            if cmd_buffer == SECRET_TRIGGER:
                cmd_buffer = ""
                if admin_auth():
                    publish_wizard()
                # back to menu loop


def handle_command(cmd: str) -> None:
    if not cmd:
        return
    if cmd == SECRET_TRIGGER:
        if admin_auth():
            publish_wizard()
        return
    # Anything else: treat as a package name to update
    write(C.CLR)
    print_header(f"Update package: {cmd}")
    run_cmd(["paru", "-S", "--needed", cmd], allow_fail=True)
    pause()


# ───── Action runner ─────────────────────────────────────────────────
def print_header(title: str, subtitle: str = "") -> None:
    write(C.SHOW)
    write(C.CLR)
    cols, _ = term_size()
    bar = "─" * max(0, cols - 4)
    write(f"{C.DIM}╭{bar}╮{C.RST}\n")
    write(f"{C.DIM}│{C.RST}  {C.BOLD}{C.SKY}{title}{C.RST}\n")
    if subtitle:
        write(f"{C.DIM}│{C.RST}  {C.DIM}{subtitle}{C.RST}\n")
    write(f"{C.DIM}╰{bar}╯{C.RST}\n\n")


def info(msg: str) -> None:
    write(f"  {C.SKY}▸{C.RST} {msg}\n")


def ok(msg: str) -> None:
    write(f"  {C.OK}✓{C.RST} {msg}\n")


def warn(msg: str) -> None:
    write(f"  {C.WARN}!{C.RST} {msg}\n")


def err(msg: str) -> None:
    write(f"  {C.ERR}✗{C.RST} {msg}\n")


def pause(prompt: str = "press any key to return to the menu") -> None:
    write(f"\n  {C.DIM2}{C.DIM}{prompt}{C.RST}\n")
    sys.stdout.flush()
    with RawMode():
        try:
            read_key()
        except KeyboardInterrupt:
            pass


def run_cmd(cmd, env=None, allow_fail: bool = False, capture: bool = False) -> int:
    pretty = " ".join(cmd) if isinstance(cmd, list) else str(cmd)
    write(f"  {C.DEEP}$ {pretty}{C.RST}\n")
    try:
        if capture:
            r = subprocess.run(cmd, env=env, capture_output=True, text=True)
            sys.stdout.write(r.stdout)
            if r.returncode != 0:
                sys.stderr.write(r.stderr)
            return r.returncode
        r = subprocess.run(cmd, env=env)
        return r.returncode
    except FileNotFoundError:
        err(f"command not found: {cmd[0] if isinstance(cmd, list) else cmd}")
        return 127
    except KeyboardInterrupt:
        warn("interrupted")
        return 130


# ───── Backup ────────────────────────────────────────────────────────
def make_snapshot(reason: str) -> Path:
    ts = datetime.now().strftime("%Y%m%d-%H%M%S")
    snap = BACKUP_ROOT / f"{ts}-{reason}"
    snap.mkdir(parents=True, exist_ok=True)
    info(f"snapshot at {snap}")

    # Package lists
    for name, cmd in [
        ("pkglist-explicit.txt", ["pacman", "-Qqe"]),
        ("pkglist-aur.txt", ["pacman", "-Qqm"]),
        ("pkglist-all.txt", ["pacman", "-Qq"]),
    ]:
        try:
            r = subprocess.run(cmd, capture_output=True, text=True)
            (snap / name).write_text(r.stdout)
        except FileNotFoundError:
            pass

    # Mirrorlist
    src = Path("/etc/pacman.d/mirrorlist")
    if src.exists():
        try:
            shutil.copy2(src, snap / "mirrorlist")
        except (PermissionError, OSError):
            pass

    # Active GlassyOS version
    for vf in (GLASSY_VERSION_FILE, GLASSY_VERSION_USER):
        if vf.exists():
            try:
                shutil.copy2(vf, snap / "glassyos-release")
            except OSError:
                pass
            break

    # Limit history to last 10 snapshots
    try:
        snaps = sorted(BACKUP_ROOT.iterdir(), key=lambda p: p.stat().st_mtime, reverse=True)
        for old in snaps[10:]:
            shutil.rmtree(old, ignore_errors=True)
    except OSError:
        pass

    ok("snapshot saved")
    return snap


# ───── Config (release URL, etc.) ────────────────────────────────────
def load_config() -> dict:
    cfg = {
        "release_manifest_url": "",
        "channel": "stable",
    }
    paths = [Path("/etc/glassyos/updater.conf"), USER_CONFIG_FILE]
    for p in paths:
        if p.exists():
            for line in p.read_text().splitlines():
                line = line.strip()
                if not line or line.startswith("#") or "=" not in line:
                    continue
                k, v = line.split("=", 1)
                cfg[k.strip().lower()] = v.strip().strip('"').strip("'")
    return cfg


def write_default_config() -> None:
    if USER_CONFIG_FILE.exists():
        return
    USER_CONFIG_DIR.mkdir(parents=True, exist_ok=True)
    USER_CONFIG_FILE.write_text(
        "# GlassyOS updater config\n"
        "# Set this to your release manifest URL when you publish your first release.\n"
        "# Example: https://github.com/<user>/glassyos/releases/latest/download/manifest.json\n"
        "release_manifest_url=\n"
        "channel=stable\n"
    )


def current_glassyos_version() -> str:
    for vf in (GLASSY_VERSION_FILE, GLASSY_VERSION_USER):
        if vf.exists():
            try:
                return vf.read_text().strip() or "unknown"
            except OSError:
                pass
    return "unknown"


# ───── Actions ───────────────────────────────────────────────────────
def action_update_glassyos() -> None:
    print_header("Update GlassyOS",
                 "Pulls the next release manifest, verifies, and applies.")
    make_snapshot("glassyos")

    cfg = load_config()
    url = cfg.get("release_manifest_url", "")
    if not url:
        warn("no release manifest URL configured")
        info(f"set release_manifest_url= in {USER_CONFIG_FILE}")
        info("once your release server is up, this command will pull from it")
        pause()
        return

    info(f"fetching manifest from {url}")
    try:
        with urllib.request.urlopen(url, timeout=20) as r:
            manifest = json.loads(r.read().decode("utf-8"))
    except (urllib.error.URLError, urllib.error.HTTPError, json.JSONDecodeError, TimeoutError) as e:
        err(f"could not load manifest: {e}")
        pause()
        return

    new_ver = manifest.get("version", "?")
    cur_ver = current_glassyos_version()
    info(f"installed: {cur_ver}    →    available: {new_ver}")

    if new_ver == cur_ver:
        ok("you are on the latest GlassyOS release")
        pause()
        return

    tar_url = manifest.get("tarball_url")
    sha = manifest.get("sha256")
    if not tar_url or not sha:
        err("manifest is missing 'tarball_url' or 'sha256'")
        pause()
        return

    info(f"downloading {tar_url}")
    target = RELEASE_DIR / f"glassyos-{new_ver}.tar.zst"
    try:
        urllib.request.urlretrieve(tar_url, target)
    except Exception as e:
        err(f"download failed: {e}")
        pause()
        return

    info("verifying checksum")
    if hashlib.sha256(target.read_bytes()).hexdigest() != sha:
        err("checksum mismatch — release rejected")
        target.unlink(missing_ok=True)
        pause()
        return
    ok("checksum verified")

    info("running release installer")
    rc = run_cmd(["sudo", "bash", "-c",
                  f"tar --use-compress-program=unzstd -xf '{target}' -C / && "
                  f"if [ -x /opt/glassyos/install.sh ]; then /opt/glassyos/install.sh; fi"],
                 allow_fail=True)
    if rc == 0:
        ok(f"GlassyOS upgraded to {new_ver}")
    else:
        err(f"installer exited with {rc}")
    pause()


def action_update_mirrors() -> None:
    print_header("Update mirrors",
                 "Re-rank and rewrite /etc/pacman.d/mirrorlist.")
    make_snapshot("mirrors")

    if shutil.which("reflector"):
        info("running reflector — this picks the 20 fastest HTTPS mirrors")
        rc = run_cmd(["sudo", "reflector",
                      "--latest", "20",
                      "--protocol", "https",
                      "--sort", "rate",
                      "--save", "/etc/pacman.d/mirrorlist"], allow_fail=True)
        if rc == 0:
            ok("mirrorlist updated")
        else:
            err("reflector failed")
    else:
        warn("reflector not installed")
        info("install with:  sudo pacman -S reflector")
        info("falling back to refreshing repo databases only")
        run_cmd(["sudo", "pacman", "-Syy"], allow_fail=True)
    pause()


def action_update_repos() -> None:
    print_header("Update repos",
                 "Refresh arch + blackarch package databases (-Syy).")
    make_snapshot("repos")

    info("refreshing arch keyring")
    run_cmd(["sudo", "pacman", "-Sy", "--needed", "--noconfirm",
             "archlinux-keyring"], allow_fail=True)

    has_blackarch = subprocess.run(["pacman", "-Qq", "blackarch-keyring"],
                                   capture_output=True).returncode == 0
    if has_blackarch:
        info("refreshing blackarch keyring")
        run_cmd(["sudo", "pacman", "-S", "--needed", "--noconfirm",
                 "blackarch-keyring"], allow_fail=True)
    else:
        info("blackarch repo is not installed (skipping)")

    info("force-refreshing all package databases")
    run_cmd(["sudo", "pacman", "-Syy"], allow_fail=True)
    ok("repositories refreshed")
    pause()


def action_update_apps() -> None:
    print_header("Update system applications",
                 "Upgrades every installed package across all package managers.")
    make_snapshot("apps")

    if shutil.which("paru"):
        info("paru — pacman + AUR")
        run_cmd(["paru", "-Syu"], allow_fail=True)
    elif shutil.which("yay"):
        info("yay — pacman + AUR")
        run_cmd(["yay", "-Syu"], allow_fail=True)
    else:
        info("pacman")
        run_cmd(["sudo", "pacman", "-Syu"], allow_fail=True)

    if shutil.which("flatpak"):
        info("flatpak")
        run_cmd(["flatpak", "update", "-y"], allow_fail=True)
    if shutil.which("pipx"):
        info("pipx")
        run_cmd(["pipx", "upgrade-all"], allow_fail=True)
    if shutil.which("rustup"):
        info("rustup toolchains")
        run_cmd(["rustup", "update"], allow_fail=True)
    if shutil.which("cargo") and shutil.which("cargo-install-update"):
        info("cargo binaries")
        run_cmd(["cargo", "install-update", "-a"], allow_fail=True)
    if shutil.which("npm"):
        prefix = subprocess.run(["npm", "config", "get", "prefix"],
                                capture_output=True, text=True).stdout.strip()
        if prefix and os.access(prefix, os.W_OK):
            info("npm global")
            run_cmd(["npm", "update", "-g"], allow_fail=True)
        else:
            warn(f"skipping npm — prefix {prefix} not user-writable")

    # Post-update hints
    pacnew = subprocess.run(["find", "/etc", "-name", "*.pacnew"],
                            capture_output=True, text=True).stdout.strip()
    if pacnew:
        warn("config files updated — review with pacdiff:")
        for p in pacnew.splitlines()[:8]:
            write(f"      {C.DIM}{p}{C.RST}\n")
    ok("applications upgraded")
    pause()


def action_update_everything() -> None:
    print_header("Update everything",
                 "Full sweep: mirrors → repos → applications → glassyOS.")
    make_snapshot("full")

    for label, fn in [
        ("mirrors", _do_mirrors),
        ("repos", _do_repos),
        ("applications", _do_apps),
        ("glassyOS", _do_glassyos),
    ]:
        info(f"━━ {label} ━━")
        try:
            fn()
        except Exception as e:
            err(f"{label} step failed: {e}")
    ok("full system update complete")
    pause()


def _do_mirrors() -> None:
    if shutil.which("reflector"):
        run_cmd(["sudo", "reflector",
                 "--latest", "20",
                 "--protocol", "https",
                 "--sort", "rate",
                 "--save", "/etc/pacman.d/mirrorlist"], allow_fail=True)


def _do_repos() -> None:
    run_cmd(["sudo", "pacman", "-Sy", "--needed", "--noconfirm",
             "archlinux-keyring"], allow_fail=True)
    if subprocess.run(["pacman", "-Qq", "blackarch-keyring"],
                      capture_output=True).returncode == 0:
        run_cmd(["sudo", "pacman", "-S", "--needed", "--noconfirm",
                 "blackarch-keyring"], allow_fail=True)
    run_cmd(["sudo", "pacman", "-Syy"], allow_fail=True)


def _do_apps() -> None:
    if shutil.which("paru"):
        run_cmd(["paru", "-Syu"], allow_fail=True)
    elif shutil.which("yay"):
        run_cmd(["yay", "-Syu"], allow_fail=True)
    else:
        run_cmd(["sudo", "pacman", "-Syu"], allow_fail=True)
    if shutil.which("flatpak"):
        run_cmd(["flatpak", "update", "-y"], allow_fail=True)


def _do_glassyos() -> None:
    cfg = load_config()
    url = cfg.get("release_manifest_url", "")
    if not url:
        warn("no release manifest URL configured — skipping GlassyOS step")
        return
    try:
        with urllib.request.urlopen(url, timeout=20) as r:
            manifest = json.loads(r.read().decode("utf-8"))
    except Exception as e:
        err(f"could not load manifest: {e}")
        return
    new_ver = manifest.get("version", "?")
    cur = current_glassyos_version()
    if new_ver == cur:
        ok(f"GlassyOS already on {cur}")
        return
    tar_url, sha = manifest.get("tarball_url"), manifest.get("sha256")
    if not (tar_url and sha):
        err("manifest missing tarball_url or sha256")
        return
    target = RELEASE_DIR / f"glassyos-{new_ver}.tar.zst"
    info(f"downloading GlassyOS {new_ver}")
    try:
        urllib.request.urlretrieve(tar_url, target)
    except Exception as e:
        err(f"download failed: {e}")
        return
    if hashlib.sha256(target.read_bytes()).hexdigest() != sha:
        err("checksum mismatch — release rejected")
        target.unlink(missing_ok=True)
        return
    run_cmd(["sudo", "bash", "-c",
             f"tar --use-compress-program=unzstd -xf '{target}' -C / && "
             f"if [ -x /opt/glassyos/install.sh ]; then /opt/glassyos/install.sh; fi"],
            allow_fail=True)


def action_update_specific() -> None:
    print_header("Update specific package",
                 "Fuzzy-search any installed package and update it.")
    make_snapshot("specific")

    if not shutil.which("fzf"):
        warn("fzf is not installed; install it with:  sudo pacman -S fzf")
        pause()
        return

    info("listing installed packages — start typing to filter, Enter to pick, Esc to cancel")
    pkgs = subprocess.run(["pacman", "-Qq"], capture_output=True, text=True).stdout
    try:
        r = subprocess.run(
            ["fzf", "--prompt=  pick a package > ", "--height=20",
             "--reverse", "--border=rounded", "--ansi"],
            input=pkgs, capture_output=True, text=True
        )
    except FileNotFoundError:
        err("fzf launch failed")
        pause()
        return

    pick = r.stdout.strip()
    if not pick:
        info("no package picked")
        pause()
        return

    info(f"updating {pick}")
    if shutil.which("paru"):
        run_cmd(["paru", "-S", "--needed", pick], allow_fail=True)
    else:
        run_cmd(["sudo", "pacman", "-S", "--needed", pick], allow_fail=True)
    ok(f"{pick} updated")
    pause()


# ───── Auth ──────────────────────────────────────────────────────────
def hash_with_salt(secret: str) -> str:
    return hashlib.sha256((SALT + secret).encode("utf-8")).hexdigest()


def admin_auth() -> bool:
    write(C.SHOW)
    write(C.CLR)
    cols, _ = term_size()
    title = "ADMIN  CONSOLE"
    bar = "═" * max(0, cols - 4)
    write(f"{C.HOT}╔{bar}╗{C.RST}\n")
    write(f"{C.HOT}║{C.RST}  {C.BOLD}{C.HOT}{title}{C.RST}{' ' * max(0, cols - 4 - len(title) - 2)}{C.HOT}║{C.RST}\n")
    write(f"{C.HOT}╚{bar}╝{C.RST}\n\n")
    write(f"  {C.DIM}Two-factor: login PIN, then admin password. "
          f"Three failed tries quit.{C.RST}\n\n")

    for attempt in range(3):
        try:
            pin = getpass.getpass("  Admin PIN:      ")
        except (EOFError, KeyboardInterrupt):
            return False
        if hash_with_salt(pin) != ADMIN_PIN_HASH:
            err(f"PIN rejected ({2 - attempt} attempts left)")
            time.sleep(0.4)
            continue
        try:
            pwd = getpass.getpass("  Admin password: ")
        except (EOFError, KeyboardInterrupt):
            return False
        if hash_with_salt(pwd) != ADMIN_PWD_HASH:
            err(f"password rejected ({2 - attempt} attempts left)")
            time.sleep(0.4)
            continue
        ok("authenticated")
        time.sleep(0.4)
        return True

    err("too many failed attempts")
    time.sleep(0.8)
    return False


# ───── Publish wizard ────────────────────────────────────────────────
GLASSY_CONFIG_DIRS = [
    "~/.config/hypr",
    "~/.config/waybar",
    "~/.config/glassy",
    "~/.config/quickshell",
    "~/.config/walker",
    "~/.config/swaync",
    "~/.config/nwg-dock-hyprland",
    "/etc/glassyos",
    "/usr/share/plymouth/themes/glassyos",
]


def expand(p: str) -> Path:
    return Path(os.path.expanduser(p))


def collect_glassy_scripts() -> list[Path]:
    out = []
    for d in (HOME / ".local/bin", Path("/usr/local/bin"), Path("/usr/bin")):
        if d.is_dir():
            for f in d.iterdir():
                if f.is_file() and f.name.startswith("glassy-"):
                    out.append(f)
    return out


def collect_explicit_packages() -> list[str]:
    r = subprocess.run(["pacman", "-Qqe"], capture_output=True, text=True)
    return [p for p in r.stdout.splitlines() if p]


def collect_aur_packages() -> list[str]:
    r = subprocess.run(["pacman", "-Qqm"], capture_output=True, text=True)
    return [p for p in r.stdout.splitlines() if p]


def fzf_multi_select(items: list[str], prompt: str) -> list[str]:
    """Return items the user kept (Tab to toggle, Enter to confirm)."""
    if not shutil.which("fzf"):
        return items  # accept all if fzf missing
    r = subprocess.run(
        ["fzf", "--multi", "--prompt", prompt, "--height", "60%",
         "--reverse", "--border", "rounded",
         "--header", "Tab toggles, Enter confirms — leave none selected = include ALL"],
        input="\n".join(items), capture_output=True, text=True
    )
    picked = [l for l in r.stdout.splitlines() if l]
    return picked or items


def bump_version(prev: str) -> str:
    """semver bump on patch; if prev is non-semver, fall back to date stamp."""
    m = re.match(r"^(\d+)\.(\d+)\.(\d+)(.*)$", prev)
    if m:
        major, minor, patch = int(m[1]), int(m[2]), int(m[3])
        return f"{major}.{minor}.{patch + 1}{m[4]}"
    return datetime.now().strftime("%Y.%m.%d")


def publish_wizard() -> None:
    write(C.SHOW)
    write(C.CLR)
    cols, _ = term_size()
    bar = "═" * max(0, cols - 4)
    write(f"{C.SKY}╔{bar}╗{C.RST}\n")
    write(f"{C.SKY}║{C.RST}  {C.BOLD}{C.ICE}PUBLISH  CONSOLE{C.RST}\n")
    write(f"{C.SKY}╚{bar}╝{C.RST}\n\n")

    cur = current_glassyos_version()
    proposed = bump_version(cur if cur != "unknown" else "0.0.0")
    info(f"current version: {C.ICE}{cur}{C.RST}")
    new_ver = input(f"  new version [{proposed}]: ").strip() or proposed
    info(f"building release {C.ICE}{new_ver}{C.RST}")

    # 1. Pick which AUR + explicit pkgs to ship
    explicit = collect_explicit_packages()
    aur = collect_aur_packages()
    info(f"explicit packages: {len(explicit)}    aur: {len(aur)}")
    info("you'll pick which AUR packages should ship in the release (Tab to select)")
    time.sleep(0.6)
    aur_kept = fzf_multi_select(sorted(aur), "  AUR packages to include > ") if aur else []

    info("now pick configs to bundle (Tab to select)")
    time.sleep(0.4)
    candidate_dirs = [d for d in GLASSY_CONFIG_DIRS if expand(d).exists()]
    bundled_dirs = fzf_multi_select(candidate_dirs, "  config dirs to include > ")

    scripts = collect_glassy_scripts()
    info(f"glassy-* scripts auto-included: {len(scripts)}")

    # 2. Build release tree under staging
    staging = RELEASE_DIR / f"staging-{new_ver}"
    if staging.exists():
        shutil.rmtree(staging)
    staging.mkdir(parents=True, exist_ok=True)

    info("staging files…")
    # Scripts
    sc_dir = staging / "scripts"
    sc_dir.mkdir()
    for s in scripts:
        try:
            shutil.copy2(s, sc_dir / s.name)
        except OSError as e:
            warn(f"skip {s}: {e}")

    # Configs
    cfg_dir = staging / "config"
    cfg_dir.mkdir()
    for d in bundled_dirs:
        src = expand(d)
        rel = d.lstrip("/").replace("~/", "home/")
        dst = cfg_dir / rel
        try:
            dst.parent.mkdir(parents=True, exist_ok=True)
            if src.is_dir():
                shutil.copytree(src, dst, dirs_exist_ok=True, symlinks=True,
                                ignore=shutil.ignore_patterns("*.lock", "node_modules", "__pycache__"))
            else:
                shutil.copy2(src, dst)
        except OSError as e:
            warn(f"skip {src}: {e}")

    # Manifest of what to install
    manifest = {
        "version": new_ver,
        "previous_version": cur,
        "channel": "stable",
        "built_at": datetime.now().isoformat(timespec="seconds"),
        "explicit_packages": sorted(explicit),
        "aur_packages": sorted(aur_kept),
        "bundled_config_dirs": bundled_dirs,
        "bundled_scripts": [s.name for s in scripts],
    }
    manifest_path = staging / "manifest.json"
    manifest_path.write_text(json.dumps(manifest, indent=2))

    # Install hook
    install_sh = staging / "install.sh"
    install_sh.write_text(INSTALL_HOOK)
    install_sh.chmod(0o755)

    # 3. Tarball
    info("packing tarball…")
    tar_path = RELEASE_DIR / f"glassyos-{new_ver}.tar.zst"
    if shutil.which("zstd"):
        # Use tar with zstd
        rc = subprocess.run(
            ["tar", "--zstd", "-cf", str(tar_path), "-C", str(staging.parent), staging.name]
        ).returncode
        if rc != 0:
            warn("zstd failed, falling back to gzip")
            tar_path = RELEASE_DIR / f"glassyos-{new_ver}.tar.gz"
            with tarfile.open(tar_path, "w:gz") as t:
                t.add(staging, arcname=staging.name)
    else:
        tar_path = RELEASE_DIR / f"glassyos-{new_ver}.tar.gz"
        with tarfile.open(tar_path, "w:gz") as t:
            t.add(staging, arcname=staging.name)

    # 4. Final manifest + hash
    sha = hashlib.sha256(tar_path.read_bytes()).hexdigest()
    release_manifest = {
        "version": new_ver,
        "tarball_url": f"<set-this-to-your-upload-URL>/{tar_path.name}",
        "tarball_name": tar_path.name,
        "sha256": sha,
        "size_bytes": tar_path.stat().st_size,
        "built_at": datetime.now().isoformat(timespec="seconds"),
        "channel": "stable",
        "previous_version": cur,
    }
    rm_path = RELEASE_DIR / f"manifest-{new_ver}.json"
    rm_path.write_text(json.dumps(release_manifest, indent=2))

    # Cleanup staging
    shutil.rmtree(staging, ignore_errors=True)

    ok(f"release built")
    write(f"\n  {C.BOLD}{C.ICE}artifact:{C.RST}\n")
    write(f"      {C.SKY}{tar_path}{C.RST}\n")
    write(f"      {C.DIM}sha256: {sha}{C.RST}\n")
    write(f"      {C.DIM}size:   {tar_path.stat().st_size // 1024} KiB{C.RST}\n")
    write(f"\n  {C.BOLD}{C.ICE}manifest:{C.RST}\n")
    write(f"      {C.SKY}{rm_path}{C.RST}\n")

    # gh hint
    write(f"\n  {C.BOLD}{C.ICE}publish:{C.RST}\n")
    if shutil.which("gh"):
        write(f"      {C.HOT}gh release create {C.ICE}v{new_ver}{C.RST} \\\n")
        write(f"          {C.SKY}{tar_path}{C.RST} \\\n")
        write(f"          {C.SKY}{rm_path}{C.RST} \\\n")
        write(f"          --title \"GlassyOS {new_ver}\" --generate-notes\n")
    else:
        write(f"      {C.DIM}install GitHub CLI:  sudo pacman -S github-cli{C.RST}\n")
        write(f"      {C.DIM}then: gh release create v{new_ver} {tar_path.name} {rm_path.name}{C.RST}\n")

    write(f"\n  {C.DIM2}{C.DIM}users running glassy-update will see this version once you upload "
          f"and set release_manifest_url= in their updater.conf{C.RST}\n")
    pause()


INSTALL_HOOK = r"""#!/usr/bin/env bash
# Auto-generated by glassy-update publish.
# Runs as root on the target system after the tarball is extracted.
set -e
HERE="$(dirname "$(readlink -f "$0")")"

# 1. Install glassy-* scripts system-wide (and to user bin too if present)
if [ -d "$HERE/scripts" ]; then
    install -d /usr/local/bin
    install -m 0755 "$HERE/scripts/"glassy-* /usr/local/bin/ 2>/dev/null || true
fi

# 2. Lay configs back into /etc and ~/.config
if [ -d "$HERE/config" ]; then
    cd "$HERE/config"
    # /etc/glassyos
    [ -d etc ] && cp -aL etc/. /etc/
    # /usr/share/plymouth/themes/glassyos
    [ -d usr ] && cp -aL usr/. /usr/
    # user dirs — only sets a default skeleton if user is invoking install
    if [ -n "$SUDO_USER" ] && [ -d home ]; then
        SUDO_HOME="$(getent passwd "$SUDO_USER" | cut -d: -f6)"
        for sub in home/*/; do
            base="${sub#home/}"; base="${base%/}"
            mkdir -p "$SUDO_HOME/$base"
            cp -aL "$sub". "$SUDO_HOME/$base/"
        done
        chown -R "$SUDO_USER:$SUDO_USER" "$SUDO_HOME/.config"
    fi
fi

# 3. Apply package list (best-effort, won't fail the install)
if [ -f "$HERE/manifest.json" ] && command -v jq >/dev/null && command -v paru >/dev/null; then
    explicit=$(jq -r '.explicit_packages[]' "$HERE/manifest.json")
    aur=$(jq -r '.aur_packages[]' "$HERE/manifest.json")
    [ -n "$explicit" ] && paru -S --needed --noconfirm $explicit || true
    [ -n "$aur" ]      && paru -S --needed --noconfirm $aur || true
fi

# 4. Stamp the version
mkdir -p /etc
ver=$(jq -r '.version' "$HERE/manifest.json" 2>/dev/null || echo unknown)
echo "$ver" > /etc/glassyos-release
echo "GlassyOS $ver installed."
"""


# ───── Dispatch ──────────────────────────────────────────────────────
ACTIONS = {
    "update_glassyos": action_update_glassyos,
    "update_mirrors":  action_update_mirrors,
    "update_repos":    action_update_repos,
    "update_apps":     action_update_apps,
    "update_everything": action_update_everything,
    "update_specific": action_update_specific,
}


def main_loop() -> None:
    write_default_config()
    splash()
    while True:
        choice = main_menu()
        if choice == "exit":
            write(C.CLR)
            write(f"{C.SKY}  ▲  GlassyOS  ·  see you soon{C.RST}\n\n")
            return
        fn = ACTIONS.get(choice)
        if fn:
            fn()


def main() -> int:
    p = argparse.ArgumentParser(
        prog="glassy-update",
        description="Interactive TUI updater + publishing console for GlassyOS.",
    )
    p.add_argument("--version", action="version", version=f"glassy-update {VERSION}")
    p.add_argument("--no-splash", action="store_true", help="skip the intro animation")
    p.add_argument("--apps", action="store_true", help="run 'update applications' non-interactively")
    p.add_argument("--full", action="store_true", help="run 'update everything' non-interactively")
    p.add_argument("trigger", nargs="?", default=None,
                   help=argparse.SUPPRESS)
    args = p.parse_args()

    # Hidden admin trigger from the shell:  glassy-update <SECRET>
    if args.trigger is not None:
        if args.trigger == SECRET_TRIGGER:
            try:
                if admin_auth():
                    publish_wizard()
            finally:
                write(C.SHOW)
            return 0
        else:
            err(f"unknown command: {args.trigger}")
            return 2

    if not supports_tty():
        # Plain CLI mode
        if args.full:
            action_update_everything()
        else:
            action_update_apps()
        return 0

    if args.apps:
        action_update_apps()
        return 0
    if args.full:
        action_update_everything()
        return 0

    if args.no_splash:
        write_default_config()
        while True:
            choice = main_menu()
            if choice == "exit":
                write(C.CLR)
                return 0
            fn = ACTIONS.get(choice)
            if fn:
                fn()

    try:
        main_loop()
    except KeyboardInterrupt:
        write(C.SHOW + "\n")
        return 130
    finally:
        write(C.SHOW)
    return 0


if __name__ == "__main__":
    sys.exit(main())

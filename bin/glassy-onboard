def build_toolbox_overview() -> Gtk.Widget:
    def body():
        wrap = vbox(0)
        wrap.set_size_request(900, -1)

        intro = label(
            "Ten commands cover the whole system lifecycle. The next slides show each one.",
            "body-large",
        )
        intro.set_margin_bottom(28)
        wrap.append(intro)

        grid = Gtk.Grid(column_spacing=18, row_spacing=18)
        grid.set_halign(Gtk.Align.CENTER)
        for i, (name, glyph, *_rest) in enumerate(TOOLS):
            cell = vbox(6, "card-soft")
            cell.set_size_request(160, 110)
            g = label(f'<span foreground="#b8d0ff" size="xx-large">{glyph}</span>')
            g.set_halign(Gtk.Align.CENTER)
            n = label(f"<b>glassy-{name}</b>", "body")
            n.set_halign(Gtk.Align.CENTER)
            cell.append(g)
            cell.append(n)
            grid.attach(cell, i % 5, i // 5, 1, 1)
        wrap.append(grid)
        return wrap

    return page_shell("THE TOOLBOX", "Ten commands. One system.", body)


def build_tool_page(idx: int, name: str, glyph: str, tagline: str, desc: str, examples: list[str]) -> Gtk.Widget:
    def body():
        card = hbox(40, "card")
        card.set_size_request(900, -1)

        # left: big glyph
        left = vbox(0)
        left.set_valign(Gtk.Align.CENTER)
        g = label(f'<span foreground="#b8d0ff">{glyph}</span>', "tool-glyph")
        g.set_halign(Gtk.Align.CENTER)
        left.append(g)
        left.set_size_request(140, -1)
        card.append(left)

        # right: text + code
        right = vbox(14)
        right.set_hexpand(True)
        right.set_valign(Gtk.Align.CENTER)

        n = label(f"glassy-{name}", "tool-name")
        n.set_xalign(0)
        right.append(n)

        tl = label(f'<i>{GLib.markup_escape_text(tagline)}</i>', "tagline")
        tl.set_xalign(0)
        right.append(tl)

        d = label(desc, "body-large")
        d.set_xalign(0)
        d.set_margin_top(8)
        d.set_margin_bottom(8)
        right.append(d)

        right.append(code_block(*examples))
        card.append(right)

        wrap = vbox(0)
        wrap.set_halign(Gtk.Align.CENTER)
        wrap.append(card)
        return wrap

    return page_shell(f"TOOL · {idx}/{len(TOOLS)}", f"glassy-{name}", body)


def build_quickshell_widgets() -> Gtk.Widget:
    binds = [
        (["Mod", "Ctrl", "M"], "Music player popup"),
        (["Mod", "Ctrl", "B"], "Battery &amp; power profile"),
        (["Mod", "Ctrl", "C"], "Calendar"),
        (["Mod", "Ctrl", "N"], "Network / Wi-Fi panel"),
        (["Mod", "Ctrl", "W"], "Wallpaper picker"),
        (["Mod", "Ctrl", "T"], "Focus-time timer"),
        (["Mod", "Ctrl", "G"], "Stewart assistant"),
    ]

    def body():
        wrap = vbox(0)
        wrap.set_size_request(820, -1)

        intro = label(
            "These open <b>Quickshell</b> popups — soft glass overlays that float "
            "above the desktop. Press the binding again to dismiss.",
            "body-large",
        )
        intro.set_xalign(0)
        intro.set_wrap(True)
        intro.set_margin_bottom(24)
        wrap.append(intro)

        rows = vbox(14, "card")
        for keys, desc in binds:
            rows.append(keyrow(keys, desc))
        wrap.append(rows)
        return wrap

    return page_shell("QUICKSHELL · POPUPS", "Mod + Ctrl summons widgets", body)


def build_waybar() -> Gtk.Widget:
    def body():
        wrap = vbox(28)
        wrap.set_size_request(960, -1)

        intro = label(
            "Your Waybar is interactive. Click the icons to open Quickshell popups — "
            "the same panels you can summon with <b>Mod + Ctrl</b> shortcuts.",
            "body-large",
        )
        intro.set_xalign(0)
        intro.set_wrap(True)
        wrap.append(intro)

        # Mock waybar
        bar = hbox(8, "waybar-mock")
        bar.set_halign(Gtk.Align.CENTER)
        bar.set_size_request(880, -1)

        # left side: workspaces + window
        left = hbox(6)
        for w in ["1", "2", "3", "4"]:
            d = Gtk.Label(label=f"  {w}  ")
            d.add_css_class("waybar-item")
            left.append(d)
        title = Gtk.Label(label="    kitty — ~/")
        title.add_css_class("waybar-item")
        title.add_css_class("dim")
        left.append(title)
        bar.append(left)

        spacer = Gtk.Box(hexpand=True)
        bar.append(spacer)

        # right side: clickable items (highlighted)
        right = hbox(4)
        for icon, css_class in [
            ("󰕾  62%", ""),
            ("󰤨", "hot"),         # Wi-Fi
            ("󱊣  84%", "hot"),     # Battery
            ("13:42", "hot"),       # Clock
        ]:
            it = Gtk.Label(label=icon)
            it.add_css_class("waybar-item")
            if css_class:
                it.add_css_class(css_class)
            right.append(it)
        bar.append(right)

        wrap.append(bar)

        # arrows + popups underneath
        callouts = hbox(20)
        callouts.set_halign(Gtk.Align.END)
        callouts.set_margin_end(20)

        for popup_title, popup_desc in [
            ("󰤨  Wi-Fi", "scan, connect, toggle radios — without leaving the bar"),
            ("󱊣  Power", "battery health, profile (saver / balanced / performance)"),
            ("  Calendar", "month view, agenda, week numbers"),
        ]:
            col = vbox(8)
            arrow = label('<span foreground="#b8d0ff" size="xx-large">↑</span>')
            arrow.set_halign(Gtk.Align.CENTER)
            col.append(arrow)

            popup = vbox(6, "popup-mock")
            popup.set_size_request(220, -1)
            popup.append(label(popup_title, "popup-title"))
            popup.append(label(popup_desc, "body"))
            col.append(popup)
            callouts.append(col)

        wrap.append(callouts)
        return wrap

    return page_shell("WAYBAR · INTERACTIVE", "Click the bar. It clicks back.", body)



# ───── Animated Cairo logo ───────────────────────────────────────────
class TriangleLogo(Gtk.DrawingArea):
    """Animated glassyOS triangle peak — same geometry as Plymouth."""

    def __init__(self, size: int = 280):
        super().__init__()
        self.size = size
        self.set_content_width(size)
        self.set_content_height(size)
        self.set_draw_func(self._draw)
        self._t0 = GLib.get_monotonic_time()
        self._t = 0.0
        self.add_tick_callback(self._tick)

    def _tick(self, widget, frame_clock):
        self._t = (frame_clock.get_frame_time() - self._t0) / 1_000_000.0
        self.queue_draw()
        return True

    def _draw(self, area, cr, w, h):
        scale = min(w, h) / 400.0
        cr.translate((w - 400 * scale) / 2.0, (h - 400 * scale) / 2.0)
        cr.scale(scale, scale)

        pulse = 0.5 + 0.5 * math.sin(self._t * 1.4)
        glow_radius = 220 + 30 * pulse

        # soft halo behind logo
        pat = self._radial_gradient(200, 200, glow_radius, pulse)
        cr.set_source(pat)
        cr.rectangle(0, 0, 400, 400)
        cr.fill()

        # outer triangle
        cr.set_source_rgba(
            184 / 255, 208 / 255, 255 / 255, 0.92 + 0.08 * pulse
        )
        cr.move_to(200, 40)
        cr.line_to(370, 360)
        cr.line_to(30, 360)
        cr.close_path()
        cr.fill()

        # cutout
        cr.set_source_rgba(7 / 255, 10 / 255, 20 / 255, 1.0)
        cr.move_to(200, 130)
        cr.line_to(295, 330)
        cr.line_to(105, 330)
        cr.close_path()
        cr.fill()

        # inner peak (pulsing)
        glow = 0.78 + 0.22 * pulse
        cr.set_source_rgba(232 / 255, 239 / 255, 255 / 255, glow)
        cr.move_to(200, 175)
        cr.line_to(250, 330)
        cr.line_to(150, 330)
        cr.close_path()
        cr.fill()

    def _radial_gradient(self, cx, cy, r, pulse):
        import cairo

        pat = cairo.RadialGradient(cx, cy, 20, cx, cy, r)
        a0 = 0.18 + 0.10 * pulse
        pat.add_color_stop_rgba(0, 184 / 255, 208 / 255, 255 / 255, a0)
        pat.add_color_stop_rgba(0.5, 184 / 255, 208 / 255, 255 / 255, a0 * 0.3)
        pat.add_color_stop_rgba(1, 0, 0, 0, 0)
        return pat


# ───── Helpers ───────────────────────────────────────────────────────
def label(text: str, *classes: str, wrap: bool = True, justify: bool = False) -> Gtk.Label:
    lbl = Gtk.Label(label=text)
    lbl.set_use_markup(True)
    lbl.set_wrap(wrap)
    if wrap:
        lbl.set_wrap_mode(Pango.WrapMode.WORD)
    if justify:
        lbl.set_justify(Gtk.Justification.CENTER)
    for c in classes:
        lbl.add_css_class(c)
    return lbl


def vbox(spacing: int = 0, *classes: str) -> Gtk.Box:
    b = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=spacing)
    for c in classes:
        b.add_css_class(c)
    return b


def hbox(spacing: int = 0, *classes: str) -> Gtk.Box:
    b = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=spacing)
    for c in classes:
        b.add_css_class(c)
    return b


def keychip(text: str) -> Gtk.Label:
    l = Gtk.Label(label=text)
    l.add_css_class("key-chip")
    return l


def keyrow(keys: list[str], desc: str) -> Gtk.Widget:
    """One row: [Key] + [Key] + [Key]   description"""
    row = hbox(8)
    row.set_valign(Gtk.Align.CENTER)
    chips = hbox(0)
    chips.set_valign(Gtk.Align.CENTER)
    for i, k in enumerate(keys):
        if i > 0:
            plus = Gtk.Label(label="+")
            plus.add_css_class("key-plus")
            chips.append(plus)
        chips.append(keychip(k))

    chips.set_size_request(280, -1)
    chips.set_halign(Gtk.Align.START)
    row.append(chips)

    arrow = Gtk.Label(label="→")
    arrow.add_css_class("dim")
    arrow.set_margin_start(8)
    arrow.set_margin_end(12)
    row.append(arrow)

    d = label(desc, "key-desc")
    d.set_halign(Gtk.Align.START)
    d.set_xalign(0)
    row.append(d)
    return row


def code_block(*lines: str) -> Gtk.Label:
    parts = []
    for ln in lines:
        parts.append(
            f'<span foreground="#ffb072" weight="bold">$</span>  {GLib.markup_escape_text(ln)}'
        )
    l = Gtk.Label()
    l.set_markup("\n".join(parts))
    l.add_css_class("code")
    l.set_xalign(0)
    l.set_halign(Gtk.Align.CENTER)
    l.set_selectable(True)
    return l


def page_shell(eyebrow: str, title: str, build_body) -> Gtk.Widget:
    """Common scaffold: small eyebrow tag + big title + body block, all centered."""
    outer = vbox(0)
    outer.set_valign(Gtk.Align.CENTER)
    outer.set_halign(Gtk.Align.CENTER)
    outer.set_margin_top(40)
    outer.set_margin_bottom(40)
    outer.set_margin_start(60)
    outer.set_margin_end(60)

    if eyebrow:
        eb = label(eyebrow.upper(), "eyebrow")
        eb.set_margin_bottom(12)
        outer.append(eb)

    t = label(title, "title-small")
    t.set_margin_bottom(28)
    outer.append(t)

    body = build_body()
    if body is not None:
        outer.append(body)

    return outer



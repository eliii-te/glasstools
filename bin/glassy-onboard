def build_welcome() -> Gtk.Widget:
    box = vbox(0)
    box.set_valign(Gtk.Align.CENTER)
    box.set_halign(Gtk.Align.CENTER)

    logo = TriangleLogo(280)
    logo.set_margin_bottom(24)
    box.append(logo)

    eb = label("WELCOME TO", "eyebrow")
    eb.set_margin_bottom(8)
    box.append(eb)

    t = label("glassyOS", "title")
    t.set_margin_bottom(18)
    box.append(t)

    s = label(
        "A clean, calm, beautifully composed Linux desktop.",
        "subtitle",
    )
    s.set_margin_bottom(12)
    box.append(s)

    s2 = label(
        '<span foreground="#8aa8ee">Three minutes. Every tool, every key.</span>',
        "body-large",
    )
    box.append(s2)
    return box


def build_philosophy() -> Gtk.Widget:
    def body():
        b = vbox(20)
        b.set_size_request(720, -1)

        for text in [
            ("●", "Every system task has a <b>glassy-*</b> command."),
            ("●", "Every command is safe by default, with clear status output."),
            ("●", "The desktop favors keyboard flow over clicking."),
            ("●", "The look stays soft, transparent, low contrast on purpose."),
        ]:
            row = hbox(16)
            row.set_halign(Gtk.Align.START)
            dot = label(f'<span foreground="#b8d0ff" size="x-large">{text[0]}</span>')
            dot.set_valign(Gtk.Align.CENTER)
            row.append(dot)
            row.append(label(text[1], "body-large"))
            b.append(row)

        sep = vbox(0, "divider")
        sep.set_size_request(-1, 1)
        sep.set_margin_top(20)
        sep.set_margin_bottom(20)
        b.append(sep)

        b.append(
            label(
                '<i>Tap → or press <span foreground="#b8d0ff">Space</span> to continue.</i>',
                "body",
            )
        )
        return b

    return page_shell("INTRODUCTION", "What is glassyOS", body)



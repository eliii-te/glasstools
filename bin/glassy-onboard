def _keys_page(eyebrow: str, title: str, rows) -> Gtk.Widget:
    def body():
        wrap = vbox(14, "card")
        wrap.set_size_request(820, -1)

        for keys, desc in rows:
            wrap.append(keyrow(keys, desc))
        return wrap

    return page_shell(eyebrow, title, body)


def build_cheatsheet() -> Gtk.Widget:
    def body():
        wrap = vbox(20)
        wrap.set_size_request(720, -1)

        wrap.append(
            label(
                "You don't have to memorize any of this.",
                "subtitle",
            )
        )

        rows = vbox(14, "card")
        rows.append(keyrow(["Mod", "H"], "Live cheat sheet — every bind, scrollable"))
        rows.append(keyrow(["Mod", "Shift", "K"], "Fuzzy-search the keybinds"))
        wrap.append(rows)

        wrap.append(
            label(
                '<i>When in doubt, hit <span foreground="#b8d0ff">Mod + H</span>.</i>',
                "tagline",
            )
        )
        return wrap

    return page_shell("ALWAYS AVAILABLE", "Cheat sheet anywhere", body)


def build_goodbye() -> Gtk.Widget:
    box = vbox(0)
    box.set_valign(Gtk.Align.CENTER)
    box.set_halign(Gtk.Align.CENTER)

    logo = TriangleLogo(220)
    logo.set_margin_bottom(20)
    box.append(logo)

    box.append(label("YOU'RE READY", "eyebrow"))
    t = label("Welcome to glassyOS.", "title-small")
    t.set_margin_top(10)
    t.set_margin_bottom(20)
    box.append(t)

    box.append(
        label(
            'Type <span foreground="#b8d0ff" font_family="monospace">glassy-</span> '
            "in any terminal and tab-complete to see every tool.",
            "body-large",
        )
    )
    hint = label(
        '<span foreground="#6c7a96">Run <span foreground="#b8d0ff" font_family="monospace">glassy-onboard</span> any time to revisit this tour.</span>',
        "body",
    )
    hint.set_margin_top(8)
    box.append(hint)
    return box


# Tool slides built from TOOLS list
def all_pages():
    pages = [
        build_welcome(),
        build_philosophy(),
        build_toolbox_overview(),
    ]
    for i, tool in enumerate(TOOLS):
        pages.append(build_tool_page(i + 1, *tool))
    pages += [
        build_quickshell_widgets(),
        build_waybar(),
        build_keys_launch(),
        build_keys_window(),
        build_keys_workspace(),
        build_keys_screenshot(),
        build_keys_system(),
        build_cheatsheet(),
        build_goodbye(),
    ]
    return pages


# ───── Window ────────────────────────────────────────────────────────
class OnboardWindow(Adw.ApplicationWindow):
    def __init__(self, app, force: bool):
        super().__init__(application=app)
        self.set_title("glassyOS · Welcome")
        self.set_default_size(1280, 800)
        self.fullscreen()
        self.add_css_class("bg")
        self._force = force

        # ESC + arrow keys to navigate
        kc = Gtk.EventControllerKey()
        kc.connect("key-pressed", self._on_key)
        self.add_controller(kc)

        outer = vbox(0)
        self.set_content(outer)

        # Carousel (the slides)
        self.carousel = Adw.Carousel()
        self.carousel.set_vexpand(True)
        self.carousel.set_hexpand(True)
        self.carousel.set_spacing(0)
        self.carousel.set_allow_scroll_wheel(True)

        self._pages = all_pages()
        # Wrap each page in a Revealer for entrance animation
        self._revealers: list[Gtk.Revealer] = []
        for i, p in enumerate(self._pages):
            rev = Gtk.Revealer()
            rev.set_transition_type(Gtk.RevealerTransitionType.SLIDE_UP)
            rev.set_transition_duration(550)
            rev.set_child(p)
            rev.set_hexpand(True)
            rev.set_vexpand(True)
            rev.set_reveal_child(i == 0)
            self._revealers.append(rev)
            self.carousel.append(rev)

        outer.append(self.carousel)

        # Bottom controls
        bottom = hbox(0)
        bottom.set_margin_start(40)
        bottom.set_margin_end(40)
        bottom.set_margin_top(16)
        bottom.set_margin_bottom(28)

        skip = Gtk.Button(label="Skip")
        skip.add_css_class("ghost")
        skip.connect("clicked", lambda *_: self._finish())
        bottom.append(skip)

        # spacer
        spacer = Gtk.Box(hexpand=True)
        bottom.append(spacer)

        # dots
        dots = Adw.CarouselIndicatorDots()
        dots.set_carousel(self.carousel)
        dots.set_valign(Gtk.Align.CENTER)
        bottom.append(dots)

        # spacer 2
        spacer2 = Gtk.Box(hexpand=True)
        bottom.append(spacer2)

        self.next_btn = Gtk.Button(label="Get started  →")
        self.next_btn.add_css_class("pill")
        self.next_btn.connect("clicked", self._on_next_clicked)
        bottom.append(self.next_btn)

        outer.append(bottom)

        self.carousel.connect("page-changed", self._on_page_changed)
        # show entrance for first page
        GLib.timeout_add(80, lambda: (self._revealers[0].set_reveal_child(True), False)[1])

    def _on_page_changed(self, carousel, idx):
        for i, rev in enumerate(self._revealers):
            if i == idx:
                rev.set_reveal_child(True)

        if idx == len(self._pages) - 1:
            self.next_btn.set_label("Done  ✓")
        elif idx == 0:
            self.next_btn.set_label("Get started  →")
        else:
            self.next_btn.set_label("Next  →")

    def _on_next_clicked(self, *_):
        idx = int(self.carousel.get_position())
        if idx >= len(self._pages) - 1:
            self._finish()
        else:
            self.carousel.scroll_to(self._revealers[idx + 1], True)

    def _on_key(self, controller, keyval, keycode, state):
        if keyval in (Gdk.KEY_Escape,):
            self._finish()
            return True
        if keyval in (Gdk.KEY_Right, Gdk.KEY_space, Gdk.KEY_Return, Gdk.KEY_Down):
            idx = int(self.carousel.get_position())
            if idx < len(self._pages) - 1:
                self.carousel.scroll_to(self._revealers[idx + 1], True)
            else:
                self._finish()
            return True
        if keyval in (Gdk.KEY_Left, Gdk.KEY_Up, Gdk.KEY_BackSpace):
            idx = int(self.carousel.get_position())
            if idx > 0:
                self.carousel.scroll_to(self._revealers[idx - 1], True)
            return True
        return False

    def _finish(self):
        if not self._force:
            try:
                MARKER_DIR.mkdir(parents=True, exist_ok=True)
                MARKER_FILE.write_text(datetime.now().isoformat() + "\n")
            except OSError:
                pass
        self.close()


class OnboardApp(Adw.Application):
    def __init__(self, force: bool):
        super().__init__(application_id="com.glassyos.Onboard")
        self._force = force
        self.connect("activate", self._on_activate)

    def _on_activate(self, app):
        provider = Gtk.CssProvider()
        provider.load_from_data(CSS)
        Gtk.StyleContext.add_provider_for_display(
            Gdk.Display.get_default(),
            provider,
            Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION,
        )

        # Force dark for our overlay
        Adw.StyleManager.get_default().set_color_scheme(Adw.ColorScheme.FORCE_DARK)

        win = OnboardWindow(self, self._force)
        win.present()


# ───── CLI ───────────────────────────────────────────────────────────
def main() -> int:
    p = argparse.ArgumentParser(
        prog="glassy-onboard",
        description="Animated GUI welcome tour for glassyOS.",
    )
    p.add_argument("--first-run", action="store_true",
                   help="run only if the onboarding has never been completed")
    p.add_argument("--force", action="store_true",
                   help="run even if completed; do not write the marker")
    p.add_argument("--reset", action="store_true",
                   help="delete the completion marker and exit")
    args = p.parse_args()

    if args.reset:
        try:
            MARKER_FILE.unlink()
            print("onboarding marker removed.")
        except FileNotFoundError:
            print("no marker to remove.")
        return 0

    if args.first_run and MARKER_FILE.exists():
        return 0

    app = OnboardApp(force=args.force)
    return app.run([])


if __name__ == "__main__":
    try:
        sys.exit(main())
    except KeyboardInterrupt:
        sys.exit(130)

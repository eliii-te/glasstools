def build_keys_workspace() -> Gtk.Widget:
    rows = [
        (["Mod", "1…0"],          "Switch to workspace 1…10"),
        (["Mod", "Shift", "1…0"], "Move window to workspace"),
        (["Mod", "A"],            "Desktop overview"),
        (["Mod", "Ctrl", "F9…F12"], "Move workspace between monitors"),
        (["Mod", "Scroll"],       "Scroll between workspaces"),
        (["Mod", "Alt", "L"],     "Toggle master / dwindle layout"),
        (["Mod", "Alt", "O"],     "Toggle blur"),
        (["Mod", "Shift", "I"],   "Toggle split (dwindle)"),
    ]
    return _keys_page("KEYS · 3/5", "Workspaces &amp; layout", rows)


